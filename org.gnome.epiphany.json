{
    "app-id": "org.gnome.Epiphany",
    "runtime": "io.elementary.Platform",
    "runtime-version": "9",
    "sdk": "io.elementary.Sdk",
    "command": "epiphany",
    "finish-args": [
        "--device=dri",
        "--filesystem=xdg-download",
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--socket=wayland",
        "--system-talk-name=org.freedesktop.GeoClue2",
        "--own-name=org.gnome.Epiphany.WebAppProvider"
    ],
    "modules": [
        {
            "name": "libpwquality",
            "buildsystem": "autotools",
            "config-opts": [
                "--disable-python-bindings",
                "--with-securedir=/app/lib/security"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libpwquality/libpwquality/archive/libpwquality-1.4.5.tar.gz",
                    "sha256": "602f1f54de52cf1589a60dd44f469a62c90d59a55d381acd45d2d1db9ca6f078",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/libpwquality/libpwquality/releases/latest",
                        "version-query": ".tag_name | sub(\"^libpwquality-\"; \"\")",
                        "url-query": "\"https://github.com/libpwquality/libpwquality/archive/\" + .tag_name + \".tar.gz\"",
                        "timestamp-query": ".published_at"
                    }
                }
            ]
        },
        {
            "name": "epiphany",
            "buildsystem": "meson",
            "config-opts": [
                "-Dgranite=enabled"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/epiphany/51/epiphany-51.rc.tar.xz",
                    "sha256": "14d585c0fa509a089f52a95621992cc2f9fec4fbd60d4a6c794b7f94e73bbd0c",
                    "x-checker-data": {
                        "type": "gnome",
                        "name": "epiphany"
                    }
                },
                {
                    "type": "patch",
                    "path": "downloads-flat.patch"
                },
                {
                    "type": "patch",
                    "path": "overview-button.patch"
                }
            ],
            "cleanup": [
                "org.gnome.Epiphany.svg"
            ]
        },
        {
            "name": "customizations",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
